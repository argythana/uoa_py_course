# Secrets and local environment
.env
.envrc

# Editors / IDEs / tool caches
.idea/
.vscode/
# .claude/: only skills/ is public (open-sourced course toolchain); settings,
# prompts, scripts, and eval reports stay local. The dissertation skill is
# secretariat process, not course toolchain — keep it private.
.claude/*
!.claude/skills/
.claude/skills/assess_postgrad_dissertation
.codex/
.gradio/

# Python virtual environment
/course_venv/

# Python / Jupyter build artefacts (any depth)
**/__pycache__/
**/.ipynb_checkpoints/
**/weights/

# Local datasets (any depth)
**/data/

# Per-lecture exercise drafts not for publication (any depth)
**/practice_exercises/outdated_files/
**/practice_exercises/simple_cases/

# Private course material — student PII, root-anchored
/admin_docs/
/ai_grades_feedback/
/dissertations/
/students_work/

# Transient grading/feedback run artefacts — dumps of a student's executed
# notebooks (student PII). Written to the repo root by the grading skill; never
# publishable. gitleaks won't catch these (they're PII, not secrets).
/exec_*.txt

# Personal scratch and unsorted material — root-anchored
/experimental/
/images/
/lectures_memes/
/old_staff_to_refactor/
/real_world_examples/
/to_read/

# MLflow lecture logs and artefacts — root-anchored
mlartifacts/
mlflow.db
# Brainstorming and notes — root-anchored
roadmap_brainstorm.md

# .gifs created in lecture notebooks
**/*.gif

# Zip bundles (e.g. e-class uploads — regenerated from source folders)
**/*.zip
